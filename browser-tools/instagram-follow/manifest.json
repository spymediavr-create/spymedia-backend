{
  "manifest_version": 3,
  "name": "SpyMedia Instagram 선택 팔로우",
  "version": "0.1.0",
  "description": "관리자에서 검토한 Instagram 프로필을 별도 창에서 확인하고 순서대로 팔로우합니다. 실제 Instagram 화면 호환성은 별도 검증이 필요합니다.",
  "permissions": ["scripting"],
  "host_permissions": ["https://www.instagram.com/*", "https://spymedia-backend.onrender.com/*"],
  "background": {"service_worker": "background.mjs", "type": "module"},
  "content_scripts": [{
    "matches": ["https://spymedia-backend.onrender.com/admin*"],
    "js": ["bridge.js"],
    "run_at": "document_idle",
    "all_frames": false
  }],
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}
}
