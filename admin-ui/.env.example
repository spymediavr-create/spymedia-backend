# Preview is a loopback-only UI review, never an authenticated login.
APP_MODE=preview
PORT=4310
# Existing administrator configuration only; leave unset until approved.
# ADMIN_LOGIN_ID=
# ADMIN_PASSWORD_SCRYPT=<salt hex, at least 16 bytes>:<scrypt key hex, 64 bytes>
# SECURE_COOKIE=true
# Node does not load this example automatically. Use environment variables.
# Only names/examples. Register real secrets in Render Environment after approval.
# NODE_ENV=production
# PUBLIC_ORIGIN=https://spymedia-backend.onrender.com
# SNS_DATA_DIR=<existing persistent mount>/<dedicated directory>
# SNS_STORAGE_PERSISTENCE=confirmed
# SNS_SINGLE_INSTANCE=confirmed
# SNS_MAX_STORAGE_BYTES=<bytes below existing available disk capacity>
# FFMPEG_PATH=<existing executable path>
# FFPROBE_PATH=<existing executable path>
# MEDIA_SIGNING_KEY=<approved secret, at least 32 random bytes as hex>
# SNS_PUBLISH_ENABLED=false
# META_GRAPH_VERSION=<version confirmed in the existing Meta app>
# IG_USER_ID=
# IG_ACCESS_TOKEN=
# IG_PUBLISH_ENABLED=false
# FB_PAGE_ID=1387247911137772
# FB_PAGE_ACCESS_TOKEN=
# FB_PUBLISH_ENABLED=false
# X_USER_ACCESS_TOKEN=
# X_PUBLISH_ENABLED=false
# X_COST_LIMIT_ACKNOWLEDGED=false
# YOUTUBE_OAUTH_CLIENT_ID=
# YOUTUBE_OAUTH_CLIENT_SECRET=
# YOUTUBE_OAUTH_REFRESH_TOKEN=
# YOUTUBE_PUBLISH_ENABLED=false

# Link mode reuses existing YouTube lookup configuration; never put key values here.
# YOUTUBE_API_KEY=<existing server configuration only>
# Legacy video operations remain disabled in production.
# SNS_LEGACY_PREPARATION_ENABLED=false
